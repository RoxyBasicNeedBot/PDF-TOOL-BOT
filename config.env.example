# [OPTIONAL] ConvertAPI Token (for PPTX/XLSX conversions, leave false to disable)
CONVERT_API=False

# [OPTIONAL] Settings & Defaults
MAX_FILE_SIZE=200
DEFAULT_NAME=False
DEFAULT_CAPTION=False
DEFAULT_LANG=eng
MULTI_LANG_SUP=True
REFER_BETA=False
ADMIN_ONLY=False
INLINE_SEARCH=True
COFFEE=True

# [OPTIONAL] Server Deployment & Webkeeper Pinger
PORT=8080
BRIDGE_TOKEN=
RENDER_URL=
