# [MANDATORY] Telegram API Credentials
API_ID=
API_HASH=
API_TOKEN=

# [MANDATORY] Database Configuration
MONGODB_URI=

# [OPTIONAL] Bot Owner & Administrators (Telegram User IDs)
OWNER_ID=
OWNER_USERNAME=
ADMINS=

# [OPTIONAL] Log & Monitoring Channels
LOG_CHANNEL=
LOG_FILE=log.txt
SEND_RESTART=True

# [OPTIONAL] Forced Subscription Channels (Leave empty or 0 if disabled)
